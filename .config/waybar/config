{
  "layer": "top",
  "exclusive": true,
  "position": "top",
  "margin-top": 9,
  "width": 1450,
  "reload_style_on_change": true,

  "modules-center": [
    "hyprland/window",
    "custom/separator",
    "hyprland/workspaces",
    "custom/separator",
    "custom/mpris",
    "custom/separator",
    "clock",
    "custom/pomo",
    "pulseaudio",
    "custom/mic",
    "backlight",
    "bluetooth",
    "custom/memorypie",
    "battery",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    },
    "disable-scroll": false,
    "reverse-scroll": false,
    "disable-scroll-wraparound": false,
    "smooth-scrolling-threshold": 0.2,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    },
    "tooltip": false
  },

  "hyprland/window": {
    "format": "{class}",
    "rewrite": {
      "^$": "Desktop"
    },
    "max-length": 15,
    "min-length": 15,
    "separate-outputs": true,
    "tooltip": false
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "custom/mpris": {
    "exec": "~/.config/waybar/scripts/mpris.sh",
    "interval": 2,
    "signal": 8,
    "return-type": "json",
    "max-length": 25,
    "min-length": 25,
    "on-click": "~/.config/waybar/scripts/media-popup.sh",
    "on-click-right": "sh -c '~/.config/waybar/scripts/mpris.sh toggle; pkill -RTMIN+8 waybar'",
    "on-scroll-up": "sh -c '~/.config/waybar/scripts/mpris.sh prev; pkill -RTMIN+8 waybar'",
    "on-scroll-down": "sh -c '~/.config/waybar/scripts/mpris.sh next; pkill -RTMIN+8 waybar'",
    "smooth-scrolling-threshold": 0.2,
    "tooltip": false
  },

  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%a, %d %b}",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "custom/mic": {
    "exec": "~/.config/waybar/scripts/mic_status.sh",
    "interval": 2,
    "signal": 9,
    "return-type": "json",
    "on-click": "sh -c '~/.config/waybar/scripts/mic_status.sh toggle; pkill -RTMIN+9 waybar'",
    "tooltip": false
  },

  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-",
    "smooth-scrolling-threshold": 0.2,
    "tooltip": false
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "on-click": "sh -lc '~/.config/waybar/scripts/bluetooth_toggle.sh'",
    "on-click-right": "sh -lc '~/.config/waybar/scripts/bluetooth_manager.sh'",
    "tooltip": false
  },

  "custom/memorypie": {
    "exec": "~/.config/waybar/scripts/memory_pie.sh",
    "interval": 2,
    "return-type": "json",
    "tooltip": false
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂"],
    "tooltip": false
  },

  "custom/pomo": {
    "exec": "~/.config/waybar/scripts/pomo.sh",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/pomo-popup.sh",
    "on-click-right": "~/.config/waybar/scripts/pomo.sh stop",
    "on-scroll-up": "~/.config/waybar/scripts/pomo.sh preset-next",
    "on-scroll-down": "~/.config/waybar/scripts/pomo.sh preset-prev",
    "smooth-scrolling-threshold": 0.2,
    "tooltip": false
  },

  "tray": {
    "spacing": 8,
    "tooltip": false
  }
}
